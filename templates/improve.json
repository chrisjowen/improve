{
  "schema_version": 1,
  "review": {
    "tool_failure_rate": 0.05,
    "min_tool_calls": 300,
    "correction_rate": 2,
    "min_sessions": 5,
    "repeated_correction_sessions": 3,
    "every_days": 90
  },
  "capture": {
    "enabled": true,
    "corrections": true
  },
  "background_dreaming": {
    "enabled": false,
    "every_days": 30,
    "command": "claude",
    "timeout_minutes": 20
  },
  "replay": {
    "enabled": true,
    "runs": 3,
    "max_cost_usd": 5,
    "k": 2,
    "tolerance": 0,
    "allow_tools": [],
    "regression": {
      "on_config_change": true,
      "min_interval_minutes": 60,
      "max_cost_usd": 2
    },
    "outcome": {
      "per_sessions": 20,
      "window_days": 30
    }
  }
}
